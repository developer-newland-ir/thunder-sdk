<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <!--
    Define Permission
    https://developer.android.com/guide/topics/permissions/defining
    https://stackoverflow.com/questions/8816623/how-to-use-custom-permissions-in-android
    -->

    <uses-permission android:name="com.thunderlight.sadad.permission.THUNDER_LIGHT" />
    <uses-permission android:name="com.thunderlight.sepehr.permission.THUNDER_LIGHT" />
    <uses-permission android:name="com.thunderlight.sep.permission.THUNDER_LIGHT" />
    <uses-permission android:name="com.thunderlight.ikcc.permission.THUNDER_LIGHT" />


    <application tools:targetApi="31">
        <receiver
            android:name=".sadad.SDKManager$SdkBroadcastReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="com.thunderlight.sadad.permission.THUNDER_LIGHT">
            <intent-filter>
                <action android:name="com.thunderlight.sadad.SEND_TXN_DATA" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".sep.SDKManager$SdkBroadcastReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="com.thunderlight.sep.permission.THUNDER_LIGHT">
            <intent-filter>
                <action android:name="com.thunderlight.sep.SEND_TXN_DATA" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".sepehr.SDKManager$SdkBroadcastReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="com.thunderlight.sepehr.permission.THUNDER_LIGHT">
            <intent-filter>
                <action android:name="com.thunderlight.sepehr.SEND_TXN_DATA" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".irankish.SDKManager$SdkBroadcastReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="com.thunderlight.ikcc.permission.THUNDER_LIGHT">
            <intent-filter>
                <action android:name="com.thunderlight.ikcc.SEND_TXN_DATA" />
            </intent-filter>
        </receiver>


    </application>

</manifest>